# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- Ada ---
ADA_BASE_URL=                # e.g. https://<instance>.ada.support
ADA_API_KEY=                 # Ada Conversations API key (Bearer token)
ADA_CHANNEL_ID=              # Ada custom channel id the conversations are created on
ADA_WEBHOOK_SECRET=          # Svix signing secret from Ada > Config > Platform > Webhooks (whsec_...)

# --- Slack (the "Ada VIP Handoff" app) ---
SLACK_BOT_TOKEN=              # bot token from OAuth & Permissions (xoxb-...)
SLACK_SIGNING_SECRET=         # app's Basic Information > App Credentials > Signing Secret
SLACK_CHANNEL_ID=             # the channel id this server serves (C... or G...)
CHANNEL_JOIN_LINK=            # permanent channel link shown to the agent, e.g. https://<workspace>.slack.com/archives/C...

# --- server ---
PORT=8080

# --- logging / observability ---
LOG_LEVEL=INFO               # INFO (recommended) logs lifecycle + decisions + errors; DEBUG adds full payloads + full message text (verbose, includes customer text)
LOG_FILE=                    # optional: also write rotating logs to this path (e.g. /var/log/slack-ada/app.log) so you can zip + send them to Ada if something breaks. Blank = stdout only.
